      ],
      "seniority_keywords": ["director", "head", "vp", "vice president", "chief"],
      "technology_keywords": ["6sense", "demandbase", "marketo", "salesforce"],
      "industry_keywords": ["software", "saas", "technology", "telecommunications", "b2b"],
      "company_size": [100, 5000],
